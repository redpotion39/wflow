#!/bin/sh
set -e

if which update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi

if which gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi

# A copy in ~/.local/bin takes precedence over /usr/bin for most users, so an
# older installation there would shadow this package and the app would keep
# running the previous version.
#
# The post-install script runs as root, so $HOME is /root and not the home of
# the person who installed the package. Every home directory is therefore
# checked explicitly.
for home_dir in /root /home/*; do
    [ -d "$home_dir" ] || continue
    local_bin="$home_dir/.local/bin/wflow"
    [ -x "$local_bin" ] || continue

    if ! cmp -s /usr/bin/wflow "$local_bin"; then
        echo "wflow: replacing the older copy in $local_bin with the packaged one"
        cp /usr/bin/wflow "$local_bin" 2>/dev/null || true
        chown --reference=/usr/bin/wflow "$local_bin" 2>/dev/null || true
    fi

    desktop="$home_dir/.local/share/applications/wflow.desktop"
    if [ -f "$desktop" ]; then
        sed -i 's|^Exec=.*|Exec=/usr/bin/wflow|' "$desktop" 2>/dev/null || true
    fi
done

exit 0
